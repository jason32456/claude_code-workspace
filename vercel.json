{
  "version": 2,
  "builds": [
    { "src": "**/*.{html,css,js,png,svg,ico,json,woff,woff2}", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/cocktail-finder/?$", "dest": "/cocktail-finder/index.html" },
    { "src": "/cocktail-finder/(.*)", "dest": "/cocktail-finder/$1" },
    { "src": "/palette/?$", "dest": "/palette/index.html" },
    { "src": "/palette/(.*)", "dest": "/palette/$1" },
    { "src": "/breathe/?$", "dest": "/breathe/index.html" },
    { "src": "/breathe/(.*)", "dest": "/breathe/$1" },
    { "src": "/streaks/?$", "dest": "/streaks/index.html" },
    { "src": "/streaks/(.*)", "dest": "/streaks/$1" },
    { "src": "/ambient-noise/?$", "dest": "/ambient-noise/index.html" },
    { "src": "/ambient-noise/(.*)", "dest": "/ambient-noise/$1" },
    { "src": "/typeblitz/?$", "dest": "/typeblitz/index.html" },
    { "src": "/typeblitz/(.*)", "dest": "/typeblitz/$1" },
    { "src": "/(.*)", "dest": "/particle-life/$1" }
  ]
}
