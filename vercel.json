{
  "version": 2,
  "builds": [
    {
      "src": "particle-life/**",
      "use": "@vercel/static"
    },
    {
      "src": "palette/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/palette(.*)",
      "dest": "/palette$1"
    },
    {
      "src": "/(.*)",
      "dest": "/particle-life/$1"
    }
  ]
}
